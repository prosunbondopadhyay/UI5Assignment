<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Dialog id="taskEditorDialog" title="{editor>/dialogTitle}" contentWidth="34rem" stretchOnPhone="true"
    draggable="true" resizable="true" horizontalScrolling="false">
    <content>
      <VBox width="100%" class="sbDialogBody">
        <Label text="{i18n>title}" required="true" labelFor="titleInput" />
        <Input id="titleInput" value="{editor>/task/title}" maxLength="70"
          liveChange=".onTitleLiveChange" valueStateText="{i18n>titleError}"
          placeholder="{i18n>titlePlaceholder}" class="sapUiTinyMarginBottom" />
        <Label text="{i18n>category}" required="true" labelFor="categoryInput" />
        <Select id="categoryInput" selectedKey="{editor>/task/category}" width="100%" class="sapUiTinyMarginBottom">
          <items>
            <core:Item key="Learning" text="{i18n>learning}" />
            <core:Item key="Planning" text="{i18n>planning}" />
            <core:Item key="Onboarding" text="{i18n>onboarding}" />
          </items>
        </Select>
        <Label text="{i18n>status}" labelFor="statusInput" />
        <Select id="statusInput" selectedKey="{editor>/task/status}" width="100%" class="sapUiTinyMarginBottom">
          <items>
            <core:Item key="Open" text="{i18n>openStatus}" />
            <core:Item key="In Progress" text="{i18n>inProgressStatus}" />
            <core:Item key="Done" text="{i18n>doneStatus}" />
          </items>
        </Select>
        <Label text="{i18n>priority}" required="true" labelFor="priorityGroup" />
        <RadioButtonGroup id="priorityGroup" columns="3" selectedIndex="{editor>/priorityIndex}" width="100%" class="sapUiTinyMarginBottom">
          <buttons>
            <RadioButton text="{i18n>lowPriority}" />
            <RadioButton text="{i18n>mediumPriority}" />
            <RadioButton text="{i18n>highPriority}" />
          </buttons>
        </RadioButtonGroup>
        <Label text="{i18n>dueDate}" required="true" labelFor="dueDatePicker" />
        <DatePicker id="dueDatePicker" value="{editor>/task/dueDate}" valueFormat="yyyy-MM-dd"
          displayFormat="medium" width="100%" change=".onDateChange"
          valueStateText="{i18n>dateError}" placeholder="{i18n>datePlaceholder}" class="sapUiTinyMarginBottom" />
        <Label text="{i18n>description}" labelFor="descriptionInput" />
        <TextArea id="descriptionInput" value="{editor>/task/description}" width="100%" rows="3" maxLength="350" class="sapUiTinyMarginBottom" />
        <CheckBox id="favoriteInput" selected="{editor>/task/favorite}" text="{i18n>favoriteTask}" />
      </VBox>
    </content>
    <beginButton>
      <Button text="{i18n>save}" type="Emphasized" press=".onSaveEditor" icon="sap-icon://save" />
    </beginButton>
    <endButton>
      <Button text="{i18n>cancel}" press=".onCancelEditor" />
    </endButton>
  </Dialog>
</core:FragmentDefinition>
